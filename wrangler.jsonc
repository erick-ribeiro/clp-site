{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clp-site",
  // Site estático, sem script. Asset request não invoca Worker.
  "compatibility_date": "2026-11-22",
  // Sem routes de propósito: o deploy sobe só em *.workers.dev
  // e não cria nem altera DNS de clp.erick.page.
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "node scripts/build.mjs",
    "watch_dir": ["index.html", "assets", "downloads", "_headers", "scripts"]
  }
}
